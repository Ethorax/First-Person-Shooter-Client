; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false

[application]

config/name="Thousand Year Tourney"
run/main_scene="res://Objects/Client/client.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.169133, 0.476951, 0.123943, 1)
boot_splash/image="res://Graphics/UI/splashcentered.png"
config/icon="res://Graphics/bullethole.png"

[autoload]

Server="*res://Scripts/Singletons/Server.gd"
Global="*res://Scripts/Singletons/Global.gd"
NetworkTime="*res://addons/netfox/network-time.gd"
NetworkTimeSynchronizer="*res://addons/netfox/network-time-synchronizer.gd"
NetworkRollback="*res://addons/netfox/rollback/network-rollback.gd"
NetworkEvents="*res://addons/netfox/network-events.gd"
NetworkPerformance="*res://addons/netfox/network-performance.gd"
MultiplayerManager="*res://Scripts/Multiplayer/multiplayer_manager.gd"
WindowTiler="*res://addons/netfox.extras/window-tiler.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/standalone_expression=0

[display]

window/size/viewport_width=2304
window/size/viewport_height=1296
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/netfox.extras/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox/plugin.cfg")

[global_group]

map=""

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 1,
"compress/normal_map": 1,
"detect_3d/compress_to": 0,
"mipmaps/generate": true,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 1,
"roughness/src_normal": "res://Graphics/Meshes/Maps/DefaultDMtextured_stonewall.png"
}

